<configuration>

    <!-- Appender pour loguer dans un fichier -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/application-errors.log</file> <!-- Nom du fichier de log -->
        <append>false</append> <!-- 'false' pour écraser le fichier à chaque démarrage -->
        <encoder>
            <!-- Affiche la date, le niveau de log, le nom de la classe et de la méthode, le message, et la pile d'appel -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %logger{50} - %msg%n%throwable</pattern>
        </encoder>
    </appender>

    <!-- Logger racine, capturant les logs de niveau ERROR et plus -->
    <root level="ERROR">
        <appender-ref ref="FILE" />
    </root>

    <!-- Optionnel : vous pouvez spécifier des loggers pour des packages ou classes spécifiques -->
    <!-- Ici, nous capturons tous les logs de niveau ERROR dans l'ensemble de l'application -->
    <logger name="org.springframework" level="ERROR" />
    <logger name="com.ide.api" level="ERROR" />
</configuration>